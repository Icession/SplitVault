{
  "expo": {
    "name": "SplitVault",
    "slug": "SplitVault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#064E3B"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.icession.splitvault",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#064E3B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "0d522757-e6ba-4168-883b-ddd77b44569c"
      }
    }
  }
}
